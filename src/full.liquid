{% if graph_full %}

  <!-- TRMNL OG -->
  <div class="layout layout--col lg:hidden">
    <img
      class="image image--contain image-dither"
      src="{{ graph_full }}"
      alt="{{ weather_title }}">
  </div>

  <!-- TRMNL X landscape -->
  <div class="layout layout--col hidden lg:block portrait:hidden">
    <img
      class="image image--contain image-dither"
      src="{{ image_full_x }}"
      alt="{{ weather_title }}">
  </div>

  <!-- TRMNL X portrait -->
  {% if secondary_available %}

    <div class="layout hidden lg:portrait:block">
      <div class="flex flex--col h--full gap--medium">

        <div class="flex flex--col">
          <img
            class="image image--contain image-dither w--full"
            src="{{ image_full_x_portrait_primary }}"
            alt="{{ weather_title }}">

          <span class="label text--center">
            {{ title }}
          </span>
        </div>

        <div class="flex flex--col">
          <img
            class="image image--contain image-dither w--full"
            src="{{ image_full_x_portrait_secondary }}"
            alt="{{ secondary_title }}">

          <span class="label text--center">
            {{ secondary_title }}
          </span>
        </div>

      </div>
    </div>

  {% else %}

    <div class="layout layout--col hidden lg:portrait:block">
      <img
        class="image image--contain image-dither w--full"
        src="{{ image_full_x }}"
        alt="{{ weather_title }}">
    </div>

  {% endif %}

{% else %}

  <!-- Error -->
  <div class="layout layout--col">
    <div class="stretch-x stretch-y">
      <span class="label">
        {{ message | default: "Unable to retrieve Météo-France data" }}
      </span>
    </div>
  </div>

{% endif %}

<!-- Global title bar:
     hidden only on TRMNL X portrait when two graphs are displayed -->
{% unless secondary_available %}
  <div class="title_bar">
    <span class="title">
      24h Meteo France
    </span>

    <span class="instance">
      {{ weather_title }}
    </span>
  </div>
{% else %}
  <div class="title_bar lg:portrait:hidden">
    <span class="title">
      24h Meteo France
    </span>

    <span class="instance">
      {{ weather_title }}
    </span>
  </div>
{% endunless %}