{% if graph_full %}
  <div class="layout layout--col">
    <img
      class="image image--contain image-dither"
      src="{{ graph_full }}"
      alt="{{ air_quality_title }}">
  </div>
{% else %}
  <div class="layout layout--col">
    <div class="stretch-x stretch-y">
      <span class="label">
        {{ message | default: "Unable to retrieve Atmo Grand Est data" }}
      </span>
    </div>
  </div>
{% endif %}

<div class="title_bar">
  <span class="title">
    24h Atmo Grand Est
  </span>

  <span class="instance">
    {{ air_quality_title }}
  </span>
</div>