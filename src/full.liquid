{% if graph_full %}
  <div class="layout layout--col lg:hidden">
    <img
      class="image image--contain image-dither"
      src="{{ graph_full }}"
      alt="{{ weather_title }}">
  </div>

  <div class="layout layout--col hidden lg:block">
    <img
      class="image image--contain image-dither portrait:w--[100cqw]"
      src="{{ image_full_x }}"
      alt="{{ weather_title }}">
  </div>
{% else %}
  <div class="layout layout--col">
    <div class="stretch-x stretch-y">
      <span class="label">
        {{ message | default: "Unable to retrieve Météo-France data" }}
      </span>
    </div>
  </div>
{% endif %}

<div class="title_bar">
  <span class="title">
    24h Meteo France
  </span>

  <span class="instance">
    {{ weather_title }}
  </span>
</div>