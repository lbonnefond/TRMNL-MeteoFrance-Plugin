{% if graph_quadrant %}
  <div class="layout layout--col pt--5">

    <!-- TRMNL X -->
    <img
      class="image image--contain image-dither hidden lg:visible"
      src="{{ image_quadrant_x }}"
      alt="{{ weather_title_compact }}">

    <!-- TRMNL OG -->
    <img
      class="image image--contain image-dither lg:hidden"
      src="{{ graph_quadrant }}"
      alt="{{ weather_title_compact }}">

  </div>
{% else %}
  <div class="layout layout--col">
    <div class="stretch-x stretch-y">
      <span class="label">
        {{ message | default: "Unable to retrieve Météo-France data" }}
      </span>
    </div>
  </div>
{% endif %}

<div class="title_bar">
  <span class="title">
    {{ weather_title_compact }}
  </span>
</div>