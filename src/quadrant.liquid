{% if graph_quadrant %}
  <div class="layout layout--col pt--5">
    <img class="image image--contain image-dither" src="{{ graph_quadrant }}" alt="{{ weather_title_compact }}">
  </div>
  {% else %}
  <div class="layout layout--col">
    <div class="stretch-x stretch-y">
      <span class="label">
        {{ message | default: "Unable to retrieve Météo-France data" }}
      </span>
    </div>
  </div>
{% endif %}
<div class="title_bar">
  <span class="title">
    {{ weather_title_compact }}
  </span>
</div>