{% if image_half_vertical %}
  <div class="layout layout--col pt--5">

    <!-- TRMNL X -->
    <img
      class="image image--contain image-dither hidden lg:visible lg:portrait:hidden"
      src="{{ image_half_vertical_x }}"
      alt="{{ weather_title }}">

    <img
      class="image image--contain image-dither hidden lg:portrait:visible"
      src="{{ image_half_vertical }}"
      alt="{{ weather_title }}">

    <!-- TRMNL OG -->
    <img
      class="image image--contain image-dither lg:hidden"
      src="{{ image_half_vertical }}"
      alt="{{ weather_title }}">

  </div>
{% else %}
  <div class="layout layout--col">
    <div class="stretch-x stretch-y">
      <span class="label">
        {{ message | default: "Unable to retrieve Météo-France data" }}
      </span>
    </div>
  </div>
{% endif %}

<div class="title_bar">
  <span class="title">
    {{ weather_title_compact }}
  </span>
</div>